# OpenLair 后端环境变量模板
# 复制为 backend/.env 使用，或直接设置进程环境变量。
# 读取优先级：进程环境 > 项目根 .env（backend/.env）。

# ── JWT 签名密钥 ──────────────────────────────────────────────
# HS256 要求 >= 32 字节的强随机值
# 生成方式：python -c "import secrets; print(secrets.token_hex(32))"
OPENLAIR_JWT_SECRET=replace-with-a-random-32-byte-secret

# ── 数据库连接串（可选；不设置则用默认 SQLite） ────────────────
# 切换 MySQL / PostgreSQL 时需先安装对应驱动：
#   uv add pymysql    # MySQL
#   uv add psycopg    # PostgreSQL
#
# SQLite（默认，无需额外依赖）：
#   DATABASE_URL=sqlite+pysqlite:///./data/lair.db
#
# MySQL：
#   DATABASE_URL=mysql+pymysql://user:password@127.0.0.1:3306/openlair
#
# PostgreSQL：
#   DATABASE_URL=postgresql+psycopg://user:password@127.0.0.1:5432/openlair

# ── CORS 允许来源（可选；默认允许本地 Vite dev server） ─────────
# 逗号分隔；生产部署时改为你的前端域名
# CORS_ORIGINS=https://app.example.com,https://admin.example.com

# ── 容器运行 worker 数（仅 Docker prestart.sh 读取） ────────────
# 本地开发直接命令行指定：uv run uvicorn app.main:app --workers N
UVICORN_WORKERS=1

# ── AI 助手 LLM（OpenAI 兼容多 provider；不配置则助手不可用） ────
# 任何 OpenAI 兼容网关均可：DeepSeek / Qwen / new-api 等
# LLM_PROVIDER=openai
# LLM_BASE_URL=https://api.deepseek.com/v1
# LLM_API_KEY=sk-your-key
# LLM_MODEL=deepseek-v4-flash

# ── AI 助手语音转写引擎切换（不配置则使用默认 dashscope） ──────
# engine: dashscope（默认）| openai-compatible（自建 whisper / 兼容网关）
# TRANSCRIBE_ENGINE=dashscope
#
# ── DashScope 参数（engine=dashscope 时使用） ──────────────────
# 阿里云百炼：qwen3-asr-flash（OpenAI 兼容 ASR 端点）
# TRANSCRIBE_BASE_URL=https://dashscope.aliyuncs.com/api/v1
# TRANSCRIBE_API_KEY=sk-your-dashscope-key
# TRANSCRIBE_MODEL=qwen3-asr-flash
#
# ── OpenAI 兼容模式参数（engine=openai-compatible 时使用） ──────
# 自建 faster-whisper-server 或任意 OpenAI 兼容 STT 网关
# TRANSCRIBE_OPENAI_BASE_URL=http://whisper-svc:8000/v1
# TRANSCRIBE_OPENAI_API_KEY=sk-xxx
# TRANSCRIBE_MODEL=whisper-1