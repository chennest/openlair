# OpenLair 后端环境变量模板
# 复制为 backend/.env 使用，或直接设置进程环境变量。
# 读取优先级：进程环境 > 项目根 .env（backend/.env）。

# ── JWT 签名密钥 ──────────────────────────────────────────────
# HS256 要求 >= 32 字节的强随机值
# 生成方式：python -c "import secrets; print(secrets.token_hex(32))"
OPENLAIR_JWT_SECRET=replace-with-a-random-32-byte-secret

# ── 数据库连接串（可选；不设置则用默认 SQLite） ────────────────
# 切换 MySQL / PostgreSQL 时需先安装对应驱动：
#   uv add pymysql    # MySQL
#   uv add psycopg    # PostgreSQL
#
# SQLite（默认，无需额外依赖）：
#   DATABASE_URL=sqlite+pysqlite:///./data/lair.db
#
# MySQL：
#   DATABASE_URL=mysql+pymysql://user:password@127.0.0.1:3306/openlair
#
# PostgreSQL：
#   DATABASE_URL=postgresql+psycopg://user:password@127.0.0.1:5432/openlair