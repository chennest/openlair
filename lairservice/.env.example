# OpenLair 后端环境变量模板
# 复制为 lairservice/.env 使用；或写入 ~/.openlair/.env（OPENLAIR_CONFIG 同目录的 .env），
# 或直接设置进程环境变量。读取优先级：进程环境 > OpenLair .env > 项目根 .env。

# JWT 签名密钥：HS256 要求 >= 32 字节的强随机值
# 生成方式：python -c "import secrets; print(secrets.token_hex(32))"
OPENLAIR_JWT_SECRET=replace-with-a-random-32-byte-secret
