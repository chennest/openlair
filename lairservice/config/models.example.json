{
  "default_route": "agent",
  "routes": {
    "agent": "openai_compatible_main",
    "chat": "openai_compatible_main",
    "summary": "openai_compatible_main"
  },
  "providers": {
    "openai_compatible_main": {
      "kind": "openai_compatible",
      "model": "gpt-4o-mini",
      "base_url": "https://api.openai.com/v1",
      "api_key_env": "OPENAI_API_KEY",
      "timeout_seconds": 60
    }
  }
}
