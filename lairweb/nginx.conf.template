# lairweb nginx 配置模板
# 托管前端静态 + SPA 回退 + /api 反代后端 + 前端版本响应头
# 运行时环境变量（entrypoint 自动 envsubst 渲染）：
#   BACKEND_URL: 后端服务地址，如 http://openlair-backend:8000
#   APP_VERSION: 前端版本（构建期注入，如 v1.2.3 / test-123）

server {
    listen 80;
    server_name _;

    root /usr/share/nginx/html;
    index index.html;

    # 后端 API 反代（BACKEND_URL 运行时注入；不附加前端版本头）
    location /api/ {
        proxy_pass ${BACKEND_URL};
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_read_timeout 300;
        client_max_body_size 20m;
    }

    # SPA history 路由回退（静态页面响应带 front-version 头）
    # index.html 不缓存：每次访问重新验证，保证客户端拿到最新资源清单（assets 带 hash 长缓存）
    location / {
        try_files $uri $uri/ /index.html;
        add_header front-version "${APP_VERSION}" always;
        add_header Cache-Control "no-cache" always;
    }

    # 静态资源缓存（Vite 产物带 hash，可长缓存；同样带 front-version 头）
    location /assets/ {
        expires 30d;
        add_header Cache-Control "public, immutable";
        add_header front-version "${APP_VERSION}" always;
    }
}
