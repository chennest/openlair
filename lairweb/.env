# OpenLair Web 本地默认环境（提交进 git，无敏感内容）
# 本地默认走内存 mock（lairweb/mock/），无需启动后端：
VITE_USE_MOCK=true
# Vite dev proxy 转发目标（切真实后端时用，见 .env.example）：
LAIRWEB_API_PROXY_TARGET=http://127.0.0.1:8001
# 直连/代理目标后端地址；留空 = 同源（Vite dev proxy 转发到 LAIRWEB_API_PROXY_TARGET）
# 本地想连真实后端时，在 .env.local（gitignore）里覆盖：
#   VITE_USE_MOCK=false
# 测试/生产由 CI 构建时注入（浏览器直连的绝对地址）：
#   VITE_USE_MOCK=false
#   VITE_API_BASE_URL=https://api.example.com
VITE_API_BASE_URL=
