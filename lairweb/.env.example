# OpenLair Web 环境变量模板
# 本地默认值见 .env（gitignore，不提交，从本模板复制创建）；个人覆盖放 .env.local（gitignore，优先于 .env）

# ── Mock 开关 ──────────────────────────────────────────────────
# true  = 开发走内存 mock（lairweb/mock/），无需启动后端（默认）
# false = 走真实后端（dev 经 Vite proxy；生产直连 VITE_API_BASE_URL）
VITE_USE_MOCK=true

# ── 后端地址（浏览器侧） ────────────────────────────────────────
# 留空 = 同源（开发时 Vite dev server 把 /api 转发到 LAIRWEB_API_PROXY_TARGET）
# 填绝对地址 = 浏览器直连该地址（后端需开 CORS，见 backend CORS_ORIGINS）
VITE_API_BASE_URL=

# ── Vite dev proxy 转发目标（仅开发模式生效） ──────────────────
# 真实后端地址；不填时回退到 VITE_API_BASE_URL，再回退 8001
LAIRWEB_API_PROXY_TARGET=http://127.0.0.1:8001